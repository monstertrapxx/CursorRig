const { contextBridge, ipcRenderer } = require('electron');

const listen = (ch) => (cb) => {
  const fn = (_e, data) => cb(data);
  ipcRenderer.on(ch, fn);
  return () => ipcRenderer.removeListener(ch, fn);
};

contextBridge.exposeInMainWorld('rigApi', {
  state: () => ipcRenderer.invoke('state'),
  listRigs: () => ipcRenderer.invoke('rigs:list'),
  loadRig: (id) => ipcRenderer.invoke('rigs:load', id),
  saveRig: (rig) => ipcRenderer.invoke('rigs:save', rig),
  deleteRig: (id) => ipcRenderer.invoke('rigs:delete', id),
  findDuplicates: () => ipcRenderer.invoke('rigs:duplicates'),
  duplicateRig: (id) => ipcRenderer.invoke('rigs:duplicate', id),
  resetFeel: (id) => ipcRenderer.invoke('rigs:resetFeel', id),
  setFeel: (id, patch) => ipcRenderer.invoke('rigs:setFeel', id, patch),
  exportChain: (id) => ipcRenderer.invoke('rigs:exportChain', id),
  patchRig: (id, patch) => ipcRenderer.invoke('rigs:patch', id, patch),
  setPanelHeight: (h) => ipcRenderer.send('panel:height', h),
  setPanelWidth: (w) => ipcRenderer.send('panel:width', w),
  setPanelSize: (w, h) => ipcRenderer.send('panel:size', w, h),
  restoreDefaults: () => ipcRenderer.invoke('rigs:restoreDefaults'),
  exportRig: (rig) => ipcRenderer.invoke('rigs:export', rig),
  importRig: () => ipcRenderer.invoke('rigs:import'),
  exportFolder: (id) => ipcRenderer.invoke('folders:export', id),
  exportSelection: (ids) => ipcRenderer.invoke('crig:exportSelection', ids),
  exportAll: () => ipcRenderer.invoke('crig:exportAll'),
  importModel: () => ipcRenderer.invoke('models:import'),
  setSettings: (patch) => ipcRenderer.invoke('settings:set', patch),
  logDebug: (m) => ipcRenderer.send('dbg', m),
  refreshActive: (id) => ipcRenderer.invoke('rigs:refresh', id),
  equipRig: (id, on = true) => ipcRenderer.invoke('rigs:equip', id, on),
  openEditor: (id) => ipcRenderer.invoke('editor:open', id),
  openInventory: () => ipcRenderer.invoke('inventory:open'),
  closeEditor: () => ipcRenderer.invoke('editor:close'),
  hidePanel: () => ipcRenderer.invoke('panel:hide'),
  toggleOverlay: () => ipcRenderer.invoke('overlay:toggle'),
  openDataFolder: () => ipcRenderer.invoke('app:openDataFolder'),
  aboutInfo: () => ipcRenderer.invoke('about:info'),
  checkUpdate: () => ipcRenderer.invoke('update:check'),
  applyUpdate: () => ipcRenderer.invoke('update:apply'),
  restartApp: () => ipcRenderer.invoke('update:restart'),
  openLink: (u) => ipcRenderer.invoke('app:openLink', u),
  onUpdateState: listen('update:state'),
  quit: () => ipcRenderer.invoke('app:quit'),
  resync: () => ipcRenderer.send('overlay:resync'),
  reportWebglFailed: () => ipcRenderer.send('overlay:webgl-failed'),
  modelUrl: (name) => 'rigapp://models/' + encodeURIComponent(name),
  onCursor: listen('cursor'),
  onBounds: listen('bounds'),
  onSettings: listen('settings'),
  onOpenInventory: listen('open-inventory'),
  onRig: listen('rig'),
  onActiveRigs: listen('rigs-active'),
  onRigsChanged: listen('rigs-changed'),
  onEditorOpenRig: listen('editor-open-rig'),
  onEditorSaveClose: listen('editor-save-close'),
});
