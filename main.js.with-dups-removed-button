      if (!r.file) return new Response('not found', { status: r.status });
      // never let Chromium keep an old copy of a model or script: edits and new models must show up straight away
      return net.fetch(pathToFileURL(r.file).toString(), { cache: 'no-store' }).then((resp) => { const h = new Headers(resp.headers); h.set('Cache-Control', 'no-store'); return new Response(resp.body, { status: resp.status, headers: h }); });
    });
  } else {
    protocol.registerFileProtocol('rigapp', (req, cb) => {   // Electron 22 (Windows 7/8/8.1 build)
      const r = resolveRigUrl(req.url);
      cb(r.file ? { path: r.file } : { error: -6 });
    });
  }
  if (IS_MAC) {
    try { app.dock?.setIcon(nativeImage.createFromPath(path.join(APP_DIR, 'assets', 'icon.png'))); } catch {}
    app.dock?.hide();
    // macOS only routes Cmd+C / Cmd+V / Cmd+Z etc. through an application menu.
    Menu.setApplicationMenu(Menu.buildFromTemplate([
      { role: 'appMenu', submenu: [
        { role: 'about' }, { type: 'separator' },
        { label: 'Open menu', accelerator: settings.hotkeyMenu, registerAccelerator: false, click: () => togglePanel(true) },
        { label: 'Rig editor…', click: () => openEditor(settings.activeRig) },
        { type: 'separator' }, { role: 'hide' }, { role: 'hideOthers' }, { type: 'separator' },
        { label: 'Quit Cursor Rig', accelerator: 'Cmd+Q', click: () => { quitting = true; app.quit(); } },
      ] },
      { role: 'editMenu' },
      { role: 'windowMenu' },
    ]));
  }
  createOverlay();
  createPanel();
  createTray();
  registerHotkeys();
  screen.on('display-metrics-changed', () => {
    const d = screen.getDisplayNearestPoint(screen.getCursorScreenPoint());
    currentDisplayId = d.id;
    overlay?.setBounds(overlayBoundsFor(d));
    sendBounds(d);
  });
  if (process.env.CURSOR_RIG_TEST) require('./scripts/selftest.js')({ modelsDir: MODELS, overlay: () => overlay, panel: () => panel, editor: () => editor, openEditor, togglePanel, updateSettings });
  else if (!settings.firstRunShown) { settings.firstRunShown = true; saveSettings(); setTimeout(() => togglePanel(true), 800); }
});

app.on('window-all-closed', (e) => e.preventDefault?.());
app.on('before-quit', () => { quitting = true; });
app.on('will-quit', () => { flushFeel(); globalShortcut.unregisterAll(); clearInterval(pollTimer); });
