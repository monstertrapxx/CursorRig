        const k = Math.round(n), base = rig.segments.find((s) => (s.attachments || []).some((a) => a.image)); let segs = rig.segments.slice(0, k);
        while (segs.length < k) { const cp = JSON.parse(JSON.stringify(base)); cp.id = rid('seg'); (cp.attachments || []).forEach((a) => { a.id = rid('att'); }); cp.name = String(base.name || 'Picture').replace(/\s*\d+$/, '') + ' ' + (segs.length + 1); segs.push(cp); }
        segs.forEach((s, i) => { s.orbit = { ...(s.orbit || {}), angle: (i * 360) / k }; });
