let overlay = null, panel = null, editor = null, tray = null;
let currentDisplayId = null;
let pollTimer = null;
let lastCursor = { x: -1, y: -1 };
let quitting = false;

const appUrl = (p) => `rigapp://app/${p}`;
const preload = path.join(APP_DIR, 'preload.js');

function broadcast(ch, data) {
  for (const w of [overlay, panel, editor, inventory]) if (w && !w.isDestroyed()) w.webContents.send(ch, data);
}

function overlayBoundsFor(display) {
  const b = { ...display.bounds };
  // A topmost window exactly covering the screen makes Windows treat it as a
  // fullscreen app (taskbar hides, notifications get suppressed).
  if (IS_WIN) b.height -= 1;
  return b;
}

function createOverlay() {
  const d = screen.getDisplayNearestPoint(screen.getCursorScreenPoint());
  currentDisplayId = d.id;
  overlay = new BrowserWindow({
    ...overlayBoundsFor(d),
    transparent: true,
    backgroundColor: '#00000000',
    frame: false,
    resizable: false,
    movable: false,
    focusable: false,
    skipTaskbar: true,
    hasShadow: false,
    show: false,
    alwaysOnTop: true,
    fullscreenable: false,
    type: IS_MAC ? 'panel' : undefined,
    webPreferences: { preload, contextIsolation: true, sandbox: true, backgroundThrottling: false },
  });
  overlay.setIgnoreMouseEvents(true);
  overlay.setAlwaysOnTop(true, 'screen-saver');
  if (IS_MAC) overlay.setVisibleOnAllWorkspaces(true, { visibleOnFullScreen: true });
  overlay.loadURL(appUrl('src/overlay/index.html'));
  overlay.webContents.on('did-finish-load', () => {
    sendBounds(d);
    broadcast('settings', eff());
    sendActiveRig();
    if (settings.overlayVisible) overlay.showInactive();
    setTimeout(() => sendBounds(d), 1200); setTimeout(() => sendBounds(d), 4000);   // once the window is really on screen, re-read where it landed
  });
  startPolling();
}

function sendBounds(d) {
  if (!overlay || overlay.isDestroyed()) return;
  const want = overlayBoundsFor(d);
  let b = want;
  try {
    let got = overlay.getBounds();
    if (got.x !== want.x || got.y !== want.y || got.width !== want.width || got.height !== want.height) { overlay.setBounds(want); got = overlay.getBounds(); }   // macOS can nudge a full-screen window down under the menu bar: ask again
    if (got.x !== want.x || got.y !== want.y || got.width !== want.width || got.height !== want.height) dbg('OVERLAY BOUNDS differ: wanted ' + JSON.stringify(want) + ' got ' + JSON.stringify(got));
    b = got;   // draw by where the window REALLY is, so the chain still lines up with the cursor
  } catch {}
  overlay.webContents.send('bounds', { ...b, display: want, workArea: d.workArea, scaleFactor: d.scaleFactor });
}

function sendActiveRig(force) {
  let ids = activeIds();
  if (!TYPES.some((t) => ids[t]) && settings.activeRig == null) {            // nothing equipped at all (first run, or the equipped one was deleted)
    const first = listRigs().find((r) => typeOfRig(r) === 'chain') || listRigs()[0];
    if (first) { settings.activeRigs = { ...(settings.activeRigs || {}), [typeOfRig(first)]: first.id }; if (typeOfRig(first) === 'chain') settings.activeRig = first.id; saveSettings(); refreshFeel(); ids = activeIds(); }
  }
  const slots = {};
  for (const t of TYPES) slots[t] = ids[t] ? loadRig(ids[t]) : null;
  for (const t of TYPES) if (ids[t]) dbg('OVERLAY READS ' + fileSig(rigFile(ids[t])));
  try { for (const t of TYPES) for (const sg of (slots[t]?.segments || [])) for (const a of (sg.attachments || [])) if (a.kind === 'model' && a.model) { const u = path.join(MODELS, a.model), d2 = path.join(APP_DIR, 'default-rigs', 'models', a.model); const st = (f) => { try { const x = fs.statSync(f); return x.size + 'b@' + x.mtime.toISOString(); } catch { return 'missing'; } }; dbg('MODEL ' + a.model + ' userData=' + st(u) + ' appCopy=' + st(d2) + ' fileHash=' + (() => { try { return crypto.createHash('sha1').update(fs.readFileSync(u)).digest('hex').slice(0, 12); } catch { return 'n/a'; } })()); } } catch {}
  dbg('SEND rigs-active' + (force ? ' (forced)' : '') + ' overlay=' + !!(overlay && !overlay.isDestroyed()) + ' ' + TYPES.map((t) => t + ':' + rigSummary(slots[t])).join(' | '));
  if (overlay && !overlay.isDestroyed()) overlay.webContents.send('rigs-active', force ? { ...slots, force: true } : slots);
}

function startPolling() {
  clearInterval(pollTimer);
  pollTimer = setInterval(() => {
    if (!overlay || overlay.isDestroyed() || !settings.overlayVisible) return;
    const p = screen.getCursorScreenPoint();
    if (p.x === lastCursor.x && p.y === lastCursor.y) return;
    lastCursor = p;
    const d = screen.getDisplayNearestPoint(p);
    if (d.id !== currentDisplayId) {
      currentDisplayId = d.id;
      overlay.setBounds(overlayBoundsFor(d));
      sendBounds(d);
    }
    overlay.webContents.send('cursor', p);
  }, 8);
}

