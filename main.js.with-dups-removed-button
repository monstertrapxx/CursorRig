    const c = patch.custom, num = (v, lo, hi) => (Number.isFinite(+v) ? Math.max(lo, Math.min(hi, +v)) : null), rid = (p) => p + '_' + Math.random().toString(36).slice(2, 9);
    if (rig.type === 'orbit' && Array.isArray(rig.segments) && rig.segments.some((s) => (s.attachments || []).some((a) => a.image))) {
      const n = num(c.count, 1, 24);
