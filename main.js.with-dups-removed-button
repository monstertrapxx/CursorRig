const fileSig = (f) => { try { const b = fs.readFileSync(f), x = fs.statSync(f); return f + ' ' + b.length + 'b mtime=' + x.mtime.toISOString() + ' sha=' + crypto.createHash('sha1').update(b).digest('hex').slice(0, 10); } catch (e) { return f + ' unreadable ' + e.message; } };
function snap(win, name) { try { if (!win || win.isDestroyed()) return; win.webContents.capturePage().then((img) => { fs.writeFileSync(path.join(APP_DIR, name), img.toPNG()); dbg('SNAPSHOT saved ' + name); }).catch((e) => dbg('snapshot failed ' + e.message)); } catch (e) { dbg('snapshot error ' + e.message); } }
function dbg(m) {
  const line = new Date().toISOString() + '  [' + process.pid + '] ' + m + '\n';
  for (const f of [DBG_FILE, path.join(app.getPath('userData'), 'debug-log.txt')]) {   // second copy lives in the app's data folder, so it survives renaming the project folder
    try { fs.appendFileSync(f, line); const st = fs.statSync(f); if (st.size > 200000) fs.writeFileSync(f, ''); } catch {}
  }
}
