// Chain links must alternate (one flat, the next turned 90 degrees) or they all lie in the same plane and stack on top of each other.
// Returns true if it changed anything.
function fixChainLinks(r) {
  const segs = (r && r.segments) || []; if (!segs.length) return false;
  const isLink = (sg) => sg && (sg.attachments || []).length === 1 && sg.attachments[0].kind !== 'model' && sg.attachments[0].shape === 'torus' && /link/i.test(sg.attachments[0].name || '');
  const byId = new Map(segs.map((x) => [x.id, x]));
  let changed = false;
  for (const sg of segs) {
    if (!isLink(sg) || isLink(byId.get(sg.parent))) continue;           // start of a run of links
    const run = []; let cur = sg;
    while (cur && isLink(cur) && run.length < 500) { run.push(cur); const kids = segs.filter((x) => x.parent === cur.id); cur = kids.length === 1 ? kids[0] : null; }
    if (run.length < 2) continue;
    const ys = run.map((x) => (x.attachments[0].rotation || [0, 0, 0])[1] || 0);
    let bad = false; for (let i = 1; i < ys.length; i++) if (Math.abs(ys[i] - ys[i - 1]) < 1) bad = true;
    if (!bad) continue;
    const first = Math.abs(ys[0] % 180) < 1 ? 0 : 90;
    run.forEach((x, i) => { const a = x.attachments[0]; const rot = [...(a.rotation || [0, 0, 0])]; rot[1] = i % 2 ? 90 - first : first; a.rotation = rot; });
    changed = true;
  }
  return changed;
}

