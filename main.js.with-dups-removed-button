// Sample chains that use model files (e.g. the conker): copy those files next to the user's own models.
function seedModels() {
  if (!samplesOn()) return;
  const dir = path.join(APP_DIR, 'default-rigs', 'models');
  if (!fs.existsSync(dir)) return;
  for (const f of fs.readdirSync(dir)) {
    const dest = path.join(MODELS, f);
    if (!fs.existsSync(dest)) fs.copyFileSync(path.join(dir, f), dest);
  }
}

function seedDefaults(overwrite) {
  if (!samplesOn()) return;
  const dir = path.join(APP_DIR, 'default-rigs');
  for (const f of fs.readdirSync(dir)) {
    if (!f.endsWith('.json')) continue;
    const dest = path.join(RIGS, f);
    if (overwrite || !fs.existsSync(dest)) fs.copyFileSync(path.join(dir, f), dest);
  }
  seedModels();
}

function saveSettings() { fs.writeFileSync(SETTINGS_FILE, JSON.stringify(settings, null, 2)); }

// ---- per-chain feel: menu settings stored inside each rig (rig.feel), falling back to global values
// One cursorchain, one cursorbit and one cursor emitter can be equipped at the same time: settings.activeRigs = { chain, orbit, particles }.
// settings.activeRig stays as "the equipped cursorchain" so the original app keeps working.
const TYPES = ['chain', 'orbit', 'particles'];
const typeOfRig = (r) => (r && (r.type === 'orbit' || r.type === 'particles') ? r.type : 'chain');
let activeFeels = {};           // type -> that rig's own feel
const pendingFeel = {};
let feelTimer = null;
function activeIds() {          // type -> rig id (only ones that still exist and are of that type)
  const out = {};
  for (const t of TYPES) { const id = settings.activeRigs?.[t]; out[t] = id && typeOfRig(loadRig(id)) === t && loadRig(id) ? id : null; }
  return out;
}
const isActive = (id) => Object.values(settings.activeRigs || {}).includes(id) || id === settings.activeRig;
const primaryFeel = () => activeFeels.chain || activeFeels.orbit || activeFeels.particles || {};
const featGlobal = () => feel.pickFeel(settings);
const eff = () => ({ ...feel.effective(settings, primaryFeel()), activeRigs: activeIds(), feels: activeFeels, featGlobal: featGlobal() });
function refreshFeel() { const ids = activeIds(); activeFeels = {}; for (const t of TYPES) if (ids[t]) activeFeels[t] = feel.pickFeel(loadRig(ids[t])?.feel); }
function writeFeel(id, patch) {
  if (!id) return;
  pendingFeel[id] = { ...(pendingFeel[id] || {}), ...patch };
  for (const t of TYPES) if (settings.activeRigs?.[t] === id) activeFeels[t] = { ...(activeFeels[t] || {}), ...patch };
  clearTimeout(feelTimer);
  feelTimer = setTimeout(flushFeel, 250); // sliders fire many times a second
}
function flushFeel() {
  clearTimeout(feelTimer);
  for (const id of Object.keys(pendingFeel)) {
    const rig = loadRig(id);
    if (rig) {
      rig.feel = { ...feel.pickFeel(rig.feel), ...pendingFeel[id] };
      try { fs.writeFileSync(rigFile(id), JSON.stringify(rig, null, 1)); } catch {}
    }
    delete pendingFeel[id];
  }
}

const safeId = (id) => String(id).replace(/[^a-zA-Z0-9_\-]/g, '_').slice(0, 80) || 'rig';
const rigFile = (id) => path.join(RIGS, safeId(id) + '.json');

function listRigs() {
  const out = [];
  for (const f of fs.readdirSync(RIGS)) {
    if (!f.endsWith('.json')) continue;
    try {
      const r = JSON.parse(fs.readFileSync(path.join(RIGS, f), 'utf8'));
      out.push({ id: r.id || f.slice(0, -5), name: r.name || f, segments: (r.segments || []).length, type: r.type });
    } catch {}
  }
  return out.sort((a, b) => a.name.localeCompare(b.name));
}

function loadRig(id) {
  try { return JSON.parse(fs.readFileSync(rigFile(id), 'utf8')); } catch { return null; }
}

function saveRig(rig) {
  rig.id = safeId(rig.id);
  fs.writeFileSync(rigFile(rig.id), JSON.stringify(rig, null, 1));
  dbg('WROTE ' + fileSig(rigFile(rig.id)));
  rigsChanged(rig.id);
  return rig.id;
}

function rigsChanged(changedId) {
  refreshFeel();
  broadcast('rigs-changed', { rigs: listRigs(), changedId });
  if (!changedId || isActive(changedId)) { sendActiveRig(); broadcast('settings', eff()); }
  rebuildTrayMenu();
}

function copyModel(src) {
  const ext = path.extname(src).toLowerCase();
  const hash = crypto.createHash('sha1').update(fs.readFileSync(src)).digest('hex').slice(0, 8);
  const base = path.basename(src, ext).replace(/[^a-zA-Z0-9_\-]/g, '_').slice(0, 40);
  const name = `${base}-${hash}${ext}`;
  const dest = path.join(MODELS, name);
  if (!fs.existsSync(dest)) fs.copyFileSync(src, dest);
  return name;
}

