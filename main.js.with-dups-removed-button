// ---- program updates for installed (dmg / installer / portable) copies
// The installed files are never edited (that would break the app's signature on macOS and needs admin rights on Windows). An update, once its
// signature has checked out (updater.js), is unpacked into a "program" folder in the user's own data folder and this file hands over to the copy in
// there on the next start. If the new version cannot start twice in a row it is dropped and the installed version runs again.
if (!global.__CR_BUNDLED_DIR) {
  let ov = null;
  try {
    if (!process.env.CURSOR_RIG_NO_OVERLAY && ((app.isPackaged && /\.asar/i.test(__dirname)) || process.env.CURSOR_RIG_OVERLAY_TEST)) {
      const base = path.join(app.getPath('userData'), 'program'), curFile = path.join(base, 'current.json');
      const { cmpVer } = require('./updater');
      const cur = JSON.parse(fs.readFileSync(curFile, 'utf8'));
      const mine = require('./package.json').version;
      const dir = path.join(base, String(cur.version));
      if (cur.version && !cur.bad && cmpVer(cur.version, mine) > 0 && fs.existsSync(path.join(dir, 'main.js'))) {
        const opkg = JSON.parse(fs.readFileSync(path.join(dir, 'package.json'), 'utf8'));
        const need = parseInt(opkg.cursorRig && opkg.cursorRig.minElectron, 10) || 0;
        if (opkg.version === cur.version && parseInt(process.versions.electron, 10) >= need) {
          if ((cur.tries || 0) >= 2) { try { fs.writeFileSync(curFile, JSON.stringify({ ...cur, bad: true })); } catch {} }
          else {
            fs.writeFileSync(curFile, JSON.stringify({ ...cur, tries: (cur.tries || 0) + 1 }));
            ov = { dir, version: cur.version, good: () => { try { fs.writeFileSync(curFile, JSON.stringify({ ...cur, tries: 0 })); } catch {} } };
          }
        }
      }
    }
  } catch {}
  if (ov) {
    global.__CR_BUNDLED_DIR = __dirname; global.__CR_OVERLAY = ov;
    process.env.NODE_PATH = [path.join(__dirname, 'node_modules'), process.env.NODE_PATH || ''].filter(Boolean).join(path.delimiter);
    require('module')._initPaths();
    require(path.join(ov.dir, 'main.js'));
    return;
  }
}

