// Equip or unequip one rig. Only one of each kind (cursorchain, cursorbit, cursor emitter) at a time.
function equipRig(id, on = true) {
  const rig = id ? loadRig(id) : null;
  if (!rig) return eff();
  flushFeel();
  const t = typeOfRig(rig);
  settings.activeRigs = { ...(settings.activeRigs || {}), [t]: on ? id : null };
  if (on && t === 'chain') settings.activeRig = id;
  saveSettings(); refreshFeel();
  broadcast('settings', eff()); sendActiveRig(); rebuildTrayMenu();
  return eff();
}

function updateSettings(patch) {
  const before = { ...settings };
  const fp = feel.pickFeel(patch);            // size/gravity/... belong to the active chain
  const rest = { ...patch };
  for (const k of feel.FEEL_KEYS) delete rest[k];
  if ('activeRig' in rest) flushFeel();
  if ('activeRig' in rest && rest.activeRig) {            // equipping through the old setting: it fills that kind's slot
    const t = typeOfRig(loadRig(rest.activeRig));
    rest.activeRigs = { ...(settings.activeRigs || {}), [t]: rest.activeRig };
    if (t !== 'chain') delete rest.activeRig;
  }
  settings = { ...settings, ...rest };
  saveSettings();
  if ('activeRig' in rest || 'activeRigs' in rest) refreshFeel();
  if (Object.keys(fp).length) writeFeel(Object.values(activeIds()).find(Boolean), fp);
  if ('overlayVisible' in rest && rest.overlayVisible !== before.overlayVisible) setOverlayVisible(rest.overlayVisible);
  if ('compatMode' in rest && rest.compatMode !== before.compatMode) askRestart('Restart Cursor Rig to change the graphics mode?', 'Compatibility graphics use software drawing: slower, but works on older computers.');
  if ('launchAtLogin' in rest) app.setLoginItemSettings({ openAtLogin: !!rest.launchAtLogin });
  if (rest.hotkeyMenu || rest.hotkeyToggle) registerHotkeys();
  broadcast('settings', eff());
  if ('activeRig' in rest || 'activeRigs' in rest) sendActiveRig();
  rebuildTrayMenu();
  return eff();
}

