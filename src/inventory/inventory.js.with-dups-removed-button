// Inventory: a bigger place to browse, sort and organise your cursorchains in folders.
// Folders and favourites are saved in the app settings, never inside a chain file, so sharing is unaffected.
import { makeThumb } from '../panel/thumbs.js';
import * as FO from '../shared/folders.js';
import { ask } from '../shared/dialog.js';
import { pickIconImage } from '../shared/foldericon.js';

const EMBED = new URLSearchParams(location.search).has('embed');   // shown on top of the menu
const api = window.rigApi || parent.rigApi;
const $ = (s) => document.querySelector(s);
const uid = () => 'g_' + Math.random().toString(36).slice(2, 8);

let rigs = [], settings = {};
let nav = { kind: 'all' };            // {kind:'all'|'fav'|'chain'|'orbit'|'none'|'folder', id}
let selected = new Set(), primary = null;
let thumbs = new Map(), pending = new Set(); const retries = new Map();
let zoom = 'm', sort = 'name', query = '';

const favs = () => new Set(settings.favoriteRigs || []);
const folders = () => settings.folders || [];
const set = (patch) => { Object.assign(settings, patch); return api.setSettings(patch); };
const byId = (id) => rigs.find((r) => r.id === id);
const isOrbit = (r) => r.type === 'orbit';
const isPart = (r) => r.type === 'particles';
const typeOf = (r) => r.type || 'chain';
const inAnyFolder = (id) => !!FO.folderOf(folders(), id);

function applyTheme() { document.documentElement.dataset.theme = settings.theme === 'light' ? 'light' : 'dark'; }

// ---------------------------------------------------------------- thumbnails
const sigOf = (r) => { const s = JSON.stringify({ ...r, feel: undefined }); let x = 0; for (let i = 0; i < s.length; i++) x = (x * 31 + s.charCodeAt(i)) | 0; return s.length + ':' + x; };
async function ensureThumb(id) {
  if (pending.has(id)) return;
  pending.add(id);
  try {
    const rig = await api.loadRig(id);
    if (!rig) return;
    const sig = sigOf(rig);
    if (thumbs.get(id)?.sig === sig) return;
    const url = await makeThumb(rig);
    thumbs.set(id, { sig, url });
    if (!url && (retries.get(id) || 0) < 3) { retries.set(id, (retries.get(id) || 0) + 1); setTimeout(() => { thumbs.delete(id); ensureThumb(id); }, 2000); }   // try again later instead of leaving a blank picture for good
    repaintSoon();
  } finally { pending.delete(id); }
}
let repaintT = null;
const repaintSoon = () => { clearTimeout(repaintT); repaintT = setTimeout(() => { renderGrid(); renderDetail(); }, 80); };

// ---------------------------------------------------------------- filtering
function visible() {
  const q = query.trim().toLowerCase(), f = favs();
  let list = rigs.filter((r) => {
    if (q && !r.name.toLowerCase().includes(q)) return false;
    switch (nav.kind) {
      case 'fav': return f.has(r.id);
      case 'chain': return typeOf(r) === 'chain';
      case 'particles': return isPart(r);
      case 'orbit': return isOrbit(r);
      case 'none': return !inAnyFolder(r.id);
      case 'folder': return FO.rigsIn(folders(), nav.id).includes(r.id) && (!nav.t || FO.typeOfFolder(folders(), nav.id) !== 'all' || typeOf(r) === nav.t);   // a shared folder only lists the kind of the tab it was opened from
      default: return true;
    }
  });
  const cmp = {
    name: (a, b) => a.name.localeCompare(b.name),
    'name-desc': (a, b) => b.name.localeCompare(a.name),
    type: (a, b) => (typeOf(a).localeCompare(typeOf(b))) || a.name.localeCompare(b.name),
    size: (a, b) => (b.segments - a.segments) || a.name.localeCompare(b.name),
  }[sort];
  return list.sort(cmp);
}

// ---------------------------------------------------------------- sidebar
function renderNav() {
  const f = favs();
  const count = {
    all: rigs.length, fav: rigs.filter((r) => f.has(r.id)).length, chain: rigs.filter((r) => typeOf(r) === 'chain').length, particles: rigs.filter(isPart).length,
    orbit: rigs.filter(isOrbit).length, none: rigs.filter((r) => !inAnyFolder(r.id)).length,
  };
  const smart = [['all', 'All chains'], ['fav', 'Favourites'], ['chain', 'Cursorchains'], ['orbit', 'Cursorbits'], ['particles', 'Cursor Emitters'], ['none', 'Home']];
  $('#smart').innerHTML = '';
  for (const [k, label] of smart) {
    const b = navBtn(label, count[k], nav.kind === k, () => go({ kind: k }));
    if (k === 'none') {      // Home: click to open it, drag chains onto it to take them out of their folder
      b.addEventListener('dragover', (e) => { e.preventDefault(); b.classList.add('drop'); });
      b.addEventListener('dragleave', () => b.classList.remove('drop'));
      b.addEventListener('drop', (e) => { e.preventDefault(); b.classList.remove('drop'); const fd = dragFolder(e); if (fd) moveFolderTo(fd, null); else moveTo(null, dragIds(e)); });
    }
    $('#smart').append(b);
  }
  const gl = $('#groups');
  gl.innerHTML = '';
  if (!folders().length) gl.innerHTML = '<div class="empty">No folders yet. Press + to make one, then drag chains onto it (drag them onto Home to take them back out). Folders can be dragged into other folders too.</div>';
  for (const [t, label] of FO.AREAS) {
    const tree = FO.flatTree(folders(), null, 0, t);
    if (!tree.length) continue;
    const h = document.createElement('div'); h.className = 'grp'; h.textContent = label; gl.append(h);
    h.addEventListener('dragover', (e) => { if (dragFolder(e)) { e.preventDefault(); h.classList.add('drop'); } });
    h.addEventListener('dragleave', () => h.classList.remove('drop'));
    h.addEventListener('drop', (e) => { e.preventDefault(); h.classList.remove('drop'); const fd = dragFolder(e); if (fd && ['all', t].includes(FO.typeOfFolder(folders(), fd))) moveFolderTo(fd, null); });
    for (const { folder: g, depth } of tree) {
      const b = navBtn(g.name, FO.countIn(folders(), g.id, (x) => byId(x) && typeOf(byId(x)) === t), nav.kind === 'folder' && nav.id === g.id && (nav.t || t) === t, () => go({ kind: 'folder', id: g.id, t }));
      b.style.paddingLeft = 8 + depth * 16 + 'px';
      b.classList.add('fld');
      if (g.icon) { const im = document.createElement('span'); im.className = 'ficon'; im.style.backgroundImage = 'url("' + g.icon + '")'; b.prepend(im); }
      b.addEventListener('dblclick', () => renameFolder(g.id));
      b.addEventListener('contextmenu', (e) => { e.preventDefault(); folderMenu(g.id); });
      b.addEventListener('dragover', (e) => { e.preventDefault(); b.classList.add('drop'); });
      b.addEventListener('dragleave', () => b.classList.remove('drop'));
      b.draggable = true;      // drag a folder onto another folder to put it inside; onto its area heading or Home to bring it back out
      b.addEventListener('dragstart', (e) => { e.dataTransfer.setData('application/x-crig-folder', g.id); e.dataTransfer.effectAllowed = 'move'; });
      b.addEventListener('drop', (e) => { e.preventDefault(); b.classList.remove('drop'); const fd = dragFolder(e); if (fd) moveFolderTo(fd, g.id); else moveTo(g.id, dragIds(e)); });
      gl.append(b);
    }
  }
}
function navBtn(label, n, on, click) {
  const b = document.createElement('button');
  b.className = on ? 'on' : '';
  b.innerHTML = '<span class="nm"></span><span class="n"></span>';
  b.querySelector('.nm').textContent = label;
  b.querySelector('.n').textContent = n;
  b.addEventListener('click', click);
  return b;
}
function go(n) { nav = n; selected.clear(); primary = null; render(); }

async function newFolder(parent = null) {
  let type = parent ? FO.typeOfFolder(folders(), parent) : ['chain', 'orbit', 'particles'].includes(nav.kind) ? nav.kind : null;
  if (!type) {
    const c = await ask('Which kind of cursorchain is the new folder for?', { choices: FO.AREAS.map(([k, label]) => ({ label, key: k })), buttons: [['Cancel', 'cancel']] });
    if (c.key === 'cancel') return; type = c.key;
  }
  const r = await ask(parent ? 'Name for the new folder inside ' + FO.getFolder(folders(), parent)?.name : 'Name for the new folder in ' + FO.areaName(type), { value: 'New folder', buttons: [['Cancel', 'cancel'], ['Create', 'ok']] });
  if (r.key !== 'ok' || !r.text) return;
  const out = FO.addFolder(folders(), r.text, parent, type);
  await set({ folders: out.folders });
  go({ kind: 'folder', id: out.folder.id });
}
async function renameFolder(id) {
  const f = FO.getFolder(folders(), id); if (!f) return;
  const r = await ask('Rename folder', { value: f.name, buttons: [['Cancel', 'cancel'], ['Rename', 'ok']] });
  if (r.key !== 'ok' || !r.text) return;
  await set({ folders: FO.renameFolder(folders(), id, r.text) });
  render();
}
async function pickFolder(title, allow = () => true, current = null, type = null) {   // null = no folder, undefined = cancelled
  const choices = [{ label: type ? FO.areaName(type) + ' (Home)' : 'Home', key: '__root', depth: 0, on: !current }, ...FO.flatTree(folders(), null, 0, type).filter((t) => allow(t.folder.id)).map((t) => ({ label: t.folder.name, key: t.folder.id, depth: t.depth + 1, on: t.folder.id === current }))];
  const r = await ask(title, { choices, buttons: [['Cancel', 'cancel']] });
  if (r.key === 'cancel') return undefined;
  return r.key === '__root' ? null : r.key;
}
async function folderMenu(id) {
  const f = FO.getFolder(folders(), id); if (!f) return;
  const empty = FO.countIn(folders(), id, (x) => !!byId(x)) === 0 && FO.childrenOf(folders(), id, null).length === 0;
  const shared = f.type === 'all';
  const r = await ask(empty ? `Folder “${f.name}” (empty)` : `Folder “${f.name}”`, { buttons: [['Cancel', 'cancel'], ['Rename', 'rename'], ['New folder inside', 'sub'], ['Move…', 'move'], ['Set icon image…', 'icon'], ['Save as .crig…', 'crig'], shared ? ['Only show on one tab…', 'unshare'] : ['Show on all 3 tabs', 'share'], ...(f.icon ? [['Remove icon', 'noicon']] : []), ...(empty ? [['Delete empty folder', 'delete']] : [['Delete folder and everything in it…', 'nuke']])] });
  if (r.key === 'icon') { const img = await pickIconImage(); if (img) { await set({ folders: FO.setFolderIcon(folders(), id, img) }); render(); } return; }
  if (r.key === 'crig') { api.exportFolder(id); return; }
  if (r.key === 'noicon') { await set({ folders: FO.setFolderIcon(folders(), id, null) }); render(); return; }
  if (r.key === 'share') {
    const par = f.parent && FO.getFolder(folders(), f.parent);
    if (par && par.type !== 'all') { await ask('Move “' + f.name + '” out to the top level first: a folder can only be shared on all 3 tabs from the top.', { buttons: [['OK', 'ok']] }); return; }
    await set({ folders: FO.setFolderType(folders(), id, 'all') }); render(); return;
  }
  if (r.key === 'unshare') {
    const c = await ask('Which tab should “' + f.name + '” stay on? Anything of the other two kinds inside it goes back to the main menu of its own tab.', { choices: FO.AREAS.map(([k, label]) => ({ label, key: k })), buttons: [['Cancel', 'cancel']] });
    if (c.key === 'cancel') return;
    await set({ folders: FO.setFolderType(folders(), id, c.key, byId) }); if (nav.kind === 'folder') nav = { kind: 'all' }; render(); return;
  }
  if (r.key === 'nuke') {
    const all = FO.everythingIn(folders(), id), ids = all.rigIds.filter((x) => !!byId(x)), nf = all.folderIds.length - 1;
    const r3 = await ask(`Delete “${f.name}”${nf ? ' and its ' + nf + ' sub-folder' + (nf === 1 ? '' : 's') : ''}, and permanently delete the ${ids.length} chain${ids.length === 1 ? '' : 's'} inside${shared ? ' (all kinds)' : ''}? This cannot be undone.`, { buttons: [['Cancel', 'cancel'], ['Delete everything', 'ok']] });
    if (r3.key !== 'ok') return;
    for (const rid of ids) await api.deleteRig(rid);
    selected.clear(); primary = null;
    await set({ folders: FO.removeFolders(folders(), all.folderIds) });
    if (nav.kind === 'folder' && all.folderIds.includes(nav.id)) nav = { kind: 'all' };
    render(); return;
  }
  if (r.key === 'rename') renameFolder(id);
  else if (r.key === 'sub') newFolder(id);
  else if (r.key === 'move') {
    const bad = new Set(FO.descendantIds(folders(), id));
    const c = await pickFolder('Move “' + f.name + '” into…', (x) => !bad.has(x), f.parent, f.type || 'chain');
    if (c !== undefined) { await set({ folders: FO.moveFolder(folders(), id, c) }); render(); }
  } else if (r.key === 'delete') {
    const r2 = await ask(`Delete the empty folder “${f.name}”?`, { buttons: [['Cancel', 'cancel'], ['Delete folder', 'ok']] });
    if (r2.key === 'ok') { await set({ folders: FO.deleteFolder(folders(), id) }); if (nav.kind === 'folder' && nav.id === id) nav = { kind: 'all' }; render(); }
  }
}
async function moveTo(fid, ids) {      // a chain only goes into a folder of its own kind
  let fl = folders();
  if (fid) {
    ids = ids.filter((i) => byId(i));
    if (ids.some((i) => !FO.fits(fl, fid, byId(i)))) {      // wrong kind for this folder: offer to share the folder on all 3 tabs instead of refusing
      const root = FO.pathOf(fl, fid)[0] || FO.getFolder(fl, fid);
      const c = await ask('“' + root.name + '” only shows on one tab. Show it on all 3 tabs (Cursorchains, Cursorbits and Cursor Emitters) so these can go in it? Each tab will only list its own kind.', { buttons: [['No', 'cancel'], ['Show on all 3 tabs', 'ok']] });
      if (c.key !== 'ok') { ids = ids.filter((i) => FO.fits(fl, fid, byId(i))); }
      else fl = FO.setFolderType(fl, root.id, 'all');
    }
  }
  if (!ids.length) return;
  await set({ folders: FO.moveRigs(fl, ids, fid) }); render();
}
const dragFolder = (e) => { try { return e.dataTransfer.getData('application/x-crig-folder') || ''; } catch { return ''; } };
async function moveFolderTo(id, target) {      // a folder only goes into a folder of its own kind, never into itself or something inside it
  if (!id || id === target || !FO.getFolder(folders(), id)) return;
  if (target && FO.typeOfFolder(folders(), target) !== 'all' && FO.typeOfFolder(folders(), target) !== FO.typeOfFolder(folders(), id)) return;
  if (target && FO.descendantIds(folders(), id).includes(target)) return;
  if ((FO.getFolder(folders(), id).parent || null) === (target || null)) return;
  await set({ folders: FO.moveFolder(folders(), id, target) }); render();
}
const dragIds = (e) => { try { return JSON.parse(e.dataTransfer.getData('text/plain')); } catch { return []; } };

// ---------------------------------------------------------------- grid
function renderGrid() {
  const grid = $('#grid');
  const keep = grid.scrollTop;
  grid.className = 'grid ' + zoom;
  grid.innerHTML = '';
  const list = visible();
  $('#count').textContent = `${list.length} of ${rigs.length}`;
  const here = nav.kind === 'folder' ? FO.pathOf(folders(), nav.id).map((x) => x.name).join(' › ') : '';
  $('#where').textContent = here;
  if (!list.length) grid.innerHTML = `<div class="empty-grid">${query ? 'Nothing matches that search.' : nav.kind === 'folder' ? 'This folder is empty. Drag chains onto it in the list on the left, or use Move… in a chain’s details.' : 'Nothing here yet.'}</div>`;
  const f = favs();
  const areaNav = ['chain', 'orbit', 'particles'].includes(nav.kind);
  if ((nav.kind === 'folder' || areaNav) && !query) for (const sub of (areaNav ? FO.childrenOf(folders(), null, nav.kind) : FO.childrenOf(folders(), nav.id))) {
    const c = document.createElement('div'); c.className = 'card fcard';
    c.innerHTML = '<div class="pic"><span class="fbig"></span></div><div class="nm"></div><div class="meta"><span>folder</span><span></span></div>';
    if (sub.icon) { const ib = c.querySelector('.fbig'); ib.classList.add('img'); ib.style.backgroundImage = 'url("' + sub.icon + '")'; }
    c.querySelector('.nm').textContent = sub.name; c.querySelectorAll('.meta span')[1].textContent = FO.countIn(folders(), sub.id, (x) => byId(x) && (!(areaNav || nav.t) || typeOf(byId(x)) === (areaNav ? nav.kind : nav.t))) + ' items';
    c.addEventListener('click', () => go({ kind: 'folder', id: sub.id, t: areaNav ? nav.kind : nav.t }));
    c.addEventListener('contextmenu', (e) => { e.preventDefault(); e.stopPropagation(); folderMenu(sub.id); });
    grid.append(c);
  }
  for (const r of list) {
    const c = document.createElement('div');
    c.className = 'card' + (selected.has(r.id) ? ' sel' : '') + (f.has(r.id) ? ' isfav' : '') + (isEq(r.id) ? ' active' : '');
    c.draggable = true;
    c.innerHTML = '<div class="pic wait"></div><div class="nm"></div><div class="meta"><span></span><span></span></div><span class="fav">★</span><span class="eq" title="Equipped"></span>';
    c.querySelector('.nm').textContent = r.name;
    const m = c.querySelectorAll('.meta span');
    m[0].textContent = typeOf(r); m[1].textContent = typeOf(r) === 'chain' ? r.segments + ' links' : '';
    const u = thumbs.get(r.id)?.url;
    if (u) { const img = document.createElement('img'); img.src = u; img.alt = ''; const p = c.querySelector('.pic'); p.classList.remove('wait'); p.append(img); } else ensureThumb(r.id);
    c.addEventListener('click', (e) => pick(r.id, e));
    c.addEventListener('dblclick', () => equip(r.id, !isEq(r.id)));   // double-click equips, or unequips if it is already on
    c.addEventListener('dragstart', (e) => { if (!selected.has(r.id)) { selected = new Set([r.id]); primary = r.id; } e.dataTransfer.setData('text/plain', JSON.stringify([...selected])); });
    grid.append(c);
  }
  grid.scrollTop = keep;
}
function pick(id, e) {
  if (e.shiftKey || e.ctrlKey || e.metaKey) { selected.has(id) ? selected.delete(id) : selected.add(id); primary = selected.size ? id : null; }
  else { selected = new Set([id]); primary = id; }
  renderGrid(); renderDetail();
}

// ---------------------------------------------------------------- details
const isEq = (id) => { const m = settings.activeRigs; return m ? Object.values(m).includes(id) : settings.activeRig === id; };
const equip = (id, on = true) => { const t = FO.rigType(byId(id)); settings.activeRigs = { ...(settings.activeRigs || {}), [t]: on ? id : null }; api.equipRig(id, on); renderGrid(); renderDetail(); };
async function toggleFav(ids) {
  const f = favs(); const allOn = ids.every((i) => f.has(i));
  ids.forEach((i) => (allOn ? f.delete(i) : f.add(i)));
  await set({ favoriteRigs: [...f] }); render();
}
async function del(ids) {
  if (!confirm(ids.length === 1 ? `Delete "${byId(ids[0])?.name}"? This cannot be undone.` : `Delete ${ids.length} chains? This cannot be undone.`)) return;
  for (const id of ids) await api.deleteRig(id);
  selected.clear(); primary = null;
}

function renderDetail() {
  const d = $('#detail');
  const ids = [...selected].filter(byId);
  d.innerHTML = '';
  if (!ids.length) { d.innerHTML = '<p class="hint">Click a chain to see its details here.<br><br>Shift or Ctrl/Cmd-click to pick several. Double-click to equip (or unequip). Drag chains onto a folder on the left to file them.</p>'; return; }
  const el = (t, props = {}, ...kids) => Object.assign(document.createElement(t), props, {}), add = (p, ...k) => { k.forEach((x) => p.append(x)); return p; };
  const btn = (label, fn, cls = '') => { const b = el('button', { className: 'btn ' + cls, textContent: label }); b.onclick = fn; return b; };
  if (ids.length > 1) {
    d.append(Object.assign(el('h2'), { textContent: ids.length + ' chains selected' }));
    d.append(Object.assign(el('span', { className: 'label' }), { textContent: 'Folder' }), folderRow(ids));
    d.append(add(el('div', { className: 'acts' }), btn('Favourite / unfavourite', () => toggleFav(ids)), btn('Share all as one .crig', () => api.exportSelection(ids)), btn('Delete', () => del(ids), 'danger')));
    return;
  }
  const r = byId(ids[0]);
  const pic = el('div', { className: 'pic' });
  const u = thumbs.get(r.id)?.url; if (u) pic.append(Object.assign(el('img'), { src: u, alt: '' })); else ensureThumb(r.id);
  const name = Object.assign(el('input'), { type: 'text', value: r.name });
  name.addEventListener('change', async () => { if (name.value.trim()) { await api.patchRig(r.id, { name: name.value.trim() }); } });
  name.addEventListener('keydown', (e) => { e.stopPropagation(); if (e.key === 'Enter') name.blur(); });
  const facts = el('div', { className: 'facts' });
  const row = (a, b) => { facts.append(Object.assign(el('span'), { textContent: a }), Object.assign(el('span'), { textContent: b })); };
  row('Kind', FO.areaName(typeOf(r)));
  if (!isPart(r)) row(isOrbit(r) ? 'Bodies' : 'Links', String(r.segments));
  row('Status', isEq(r.id) ? 'Equipped' : 'In your inventory');
  d.append(pic, name, facts, Object.assign(el('span', { className: 'label' }), { textContent: 'Folder' }), folderRow([r.id]));
  d.append(add(el('div', { className: 'acts' }),
    btn(isEq(r.id) ? 'Unequip' : 'Equip', () => equip(r.id, !isEq(r.id)), isEq(r.id) ? '' : 'primary'),
    btn('Edit in editor', () => api.openEditor(r.id)),
    btn(favs().has(r.id) ? 'Unfavourite' : 'Favourite', () => toggleFav([r.id])),
    btn('Duplicate', async () => { await api.duplicateRig(r.id); }),
    btn('Share .crig', () => api.exportChain(r.id)),
    btn('Delete', () => del([r.id]), 'danger')));
}
function folderRow(ids) {      // which folder these chains are in, with a button to move them
  const wrap = document.createElement('div'); wrap.className = 'frow';
  const here = [...new Set(ids.map((i) => FO.folderOf(folders(), i)?.id ?? null))];
  const name = document.createElement('span');
  name.textContent = here.length > 1 ? 'Several folders' : here[0] ? FO.pathOf(folders(), here[0]).map((f) => f.name).join(' › ') : 'Home';
  const b = document.createElement('button'); b.className = 'btn'; b.textContent = 'Move…';
  b.onclick = async () => { const kinds = [...new Set(ids.map((i) => FO.rigType(byId(i))))];
    if (kinds.length > 1) { await ask('Pick chains of one kind (Cursorchains, Cursorbits or Cursor Emitters) to move them into a folder.', { buttons: [['OK', 'ok']] }); return; }
    const c = await pickFolder(ids.length > 1 ? `Move ${ids.length} chains to…` : 'Move to…', () => true, here.length === 1 ? here[0] : undefined, kinds[0]); if (c !== undefined) moveTo(c, ids); };
  wrap.append(name, b);
  return wrap;
}
// ---------------------------------------------------------------- wiring
function render() { renderNav(); renderGrid(); renderDetail(); }
$('#q').addEventListener('input', (e) => { query = e.target.value; renderGrid(); });
$('#sort').addEventListener('change', (e) => { sort = e.target.value; set({ inventorySort: sort }); renderGrid(); });
document.querySelectorAll('#zoom button').forEach((b) => b.addEventListener('click', () => { zoom = b.dataset.z; set({ inventoryZoom: zoom }); paintZoom(); renderGrid(); }));
const paintZoom = () => document.querySelectorAll('#zoom button').forEach((b) => b.classList.toggle('on', b.dataset.z === zoom));
if (EMBED) { document.body.classList.add('embed'); $('#close').onclick = () => parent.postMessage({ inv: 'close' }, '*'); }
$('#g-all').onclick = () => api.exportAll();
// the Find duplicates button only shows while Shift is held down
const showDups = (on) => { $('#dups').hidden = !on; };
window.addEventListener('keydown', (e) => { if (e.key === 'Shift') showDups(true); });
window.addEventListener('keyup', (e) => { if (e.key === 'Shift') showDups(false); });
window.addEventListener('blur', () => showDups(false));
$('#dups').onclick = async () => {
  const ids = (await api.findDuplicates()).filter((i) => byId(i));
  if (!ids.length) { await ask('No duplicates found: nothing is an exact copy of something else.', { buttons: [['OK', 'ok']] }); return; }
  nav = { kind: 'all' }; query = ''; $('#q').value = ''; selected = new Set(ids); primary = ids[0]; render();
  await ask(ids.length + ' exact cop' + (ids.length === 1 ? 'y is' : 'ies are') + ' selected (one of each is kept: the one that is equipped, in a folder or a favourite). Press Delete in the panel on the right to remove them all.', { buttons: [['OK', 'ok']] });
};
$('#g-new').onclick = () => newFolder(nav.kind === 'folder' ? nav.id : null);
window.addEventListener('keydown', (e) => {
  if (e.target.matches('input, select')) return;
  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'a') { e.preventDefault(); selected = new Set(visible().map((r) => r.id)); primary = [...selected][0] ?? null; renderGrid(); renderDetail(); }
  else if (e.key === 'Enter' && primary) equip(primary, true);
  else if (e.key === 'Escape') { if (selected.size) { selected.clear(); primary = null; renderGrid(); renderDetail(); } else if (EMBED) parent.postMessage({ inv: 'close' }, '*'); }
});

api.onSettings((s) => { settings = { ...settings, ...s }; applyTheme(); render(); });
api.onRigsChanged((d) => { rigs = d.rigs; thumbs = new Map([...thumbs].filter(([id]) => rigs.some((r) => r.id === id))); [...selected].forEach((i) => !byId(i) && selected.delete(i)); thumbs.forEach((_, id) => { if (d.changedId === id) thumbs.delete(id); }); render(); });

const st = await api.state();
settings = { ...st.globals, ...st.settings }; rigs = st.rigs;
zoom = settings.inventoryZoom || 'm'; sort = settings.inventorySort || 'name';
$('#sort').value = sort; paintZoom(); applyTheme();
render();

// right-click on empty space in the grid: make a new folder (inside the folder you are looking at, if any)
document.addEventListener('contextmenu', (e) => {
  if (e.target.closest('.card, .fcard, .detail, button, input, .glist, [data-folder]')) return;
  e.preventDefault();
  ask('Library', { buttons: [['Cancel', 'cancel'], ['New folder', 'new']] }).then((r) => { if (r.key === 'new') newFolder(nav.kind === 'folder' ? nav.id : null); });
});
